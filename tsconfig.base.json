{
  "compilerOptions": {
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@org/source"],
    "paths": {
      "remote1/Routes": ["./apps/remote1/src/app/remote-entry/entry.routes.ts"],
      "remote2/Routes": ["./apps/remote2/src/app/remote-entry/entry.routes.ts"],
      "remote3/Routes": ["./apps/remote3/src/app/remote-entry/entry.routes.ts"],
      "remote4/Routes": ["./apps/remote4/src/app/remote-entry/entry.routes.ts"],
      "remote5/Routes": ["./apps/remote5/src/app/remote-entry/entry.routes.ts"],
      "remote6/Routes": ["./apps/remote6/src/app/remote-entry/entry.routes.ts"]
    }
  }
}
